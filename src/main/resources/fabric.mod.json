{
  "schemaVersion": 1,
  "id": "ppltrades",
  "version": "${version}",
  "name": "PPLTrades",
  "description": "Unofficial PepeLand trading helper (not affiliated with PepeLand): trading zone categories and crowd-sourced shop prices in item tooltips, an item info window (I key) and sign search with Pochatok (N key). Sends barrel prices you open in the trading zone to the stats server; can be turned off in the settings.",
  "authors": ["Sink_Q"],
  "contact": {
    "homepage": "https://ppltrades.pages.dev",
    "sources": "https://github.com/SinkQ/PPLTrades",
    "issues": "https://github.com/SinkQ/PPLTrades/issues"
  },
  "license": "MIT",
  "icon": "assets/ppltrades/logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.sink_q.ppltrades.Ppltrades"
    ],
    "jei_mod_plugin": [
      "ru.sink_q.ppltrades.compat.jei.PpltradesJeiPlugin"
    ],
    "modmenu": [
      "ru.sink_q.ppltrades.compat.modmenu.PpltradesModMenu"
    ]
  },
  "mixins": [
    "ppltrades.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "pochatok": "*",
    "jei": "*",
    "modmenu": "*",
    "cloth-config": "*"
  }
}
